<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>SimpleEdit</string>
	<key>CFBundleIdentifier</key>
	<string>com.sifat.simpleedit</string>
	<!-- CFBundleName is what titles the application menu; keep it short. -->
	<key>CFBundleName</key>
	<string>SimpleEdit</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.4</string>
	<key>CFBundleVersion</key>
	<string>6</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Resolved against Contents/Resources; the .icns extension is implied. -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>

	<!-- TCC gates these folders for non-sandboxed apps too, and restoring tabs
	     at launch reads files without an open panel, which can trip a prompt. -->
	<key>NSDocumentsFolderUsageDescription</key>
	<string>SimpleEdit needs access to reopen the text files you were last editing.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>SimpleEdit needs access to reopen the text files you were last editing.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>SimpleEdit needs access to reopen the text files you were last editing.</string>

	<key>CFBundleDocumentTypes</key>
	<array>
		<!-- public.text, NOT public.plain-text. public.json conforms to
		     public.text and NOT to public.plain-text, so declaring plain-text
		     alone makes Cmd+O silently refuse .json files, with no signal
		     anywhere in the build. public.text also covers source code, YAML
		     and Markdown. Without at least one Editor entry,
		     NSDocumentController.defaultType is nil and Cmd+N fails silently. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Text Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.text</string>
			</array>
			<!-- Resolved by string at runtime with no compile-time check. The
			     bare name works only because the class is @objc(TextDocument);
			     a Swift class otherwise registers as Module.Class. -->
			<key>NSDocumentClass</key>
			<string>TextDocument</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Any Document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.data</string>
			</array>
			<key>NSDocumentClass</key>
			<string>TextDocument</string>
		</dict>
	</array>
</dict>
</plist>
